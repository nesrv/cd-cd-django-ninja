{
    "build": { "builder": "NIXPACKS" },
    "deploy": {
      "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 5 --threads 2 --timeout 30 --max-requests 10000 --max-requests-jitter 1000",
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 3
    }
  }